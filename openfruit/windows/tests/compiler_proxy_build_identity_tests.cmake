if(NOT DEFINED OPENFRUIT_IDENTITY_TEST_ROOT)
    message(FATAL_ERROR "An isolated owned test root is required")
endif()
set(root "${OPENFRUIT_IDENTITY_TEST_ROOT}")
file(MAKE_DIRECTORY "${root}")
set(module "${CMAKE_CURRENT_LIST_DIR}/../cmake/CompilerProxyIdentity.cmake")
set(output "${root}/identity.hpp")
set(inputs "${root}/inputs.cmake")
file(WRITE "${root}/compiler.cpp" "// owned compiler input\n")
file(WRITE "${root}/shared.hpp" "// owned shared header\n")
file(WRITE "${root}/generator.cmake" "# owned generator input\n")
file(MAKE_DIRECTORY "${root}/include" "${root}/lib" "${root}/binary/generated/compiler-proxy-identity/Release" "${root}/binary/Testing")
file(WRITE "${root}/include/vector" "// extensionless native standard library header\n")
file(WRITE "${root}/lib/owned.lib" "owned native import library\n")
file(WRITE "${root}/native-tool.exe" "owned native tool identity\n")
file(WRITE "${root}/binary/generated-config.h" "// native generated header\n")
function(write_inputs options)
    string(HEX "${options}" encoded)
    file(WRITE "${inputs}"
        "set(OPENFRUIT_PROXY_FILES [==[${root}/compiler.cpp;${root}/shared.hpp;${root}/generator.cmake;${root}/native-tool.exe${ARGN}]==])\nset(OPENFRUIT_PROXY_INCLUDE_ROOTS [==[${root}/include]==])\nset(OPENFRUIT_PROXY_LINK_ROOTS [==[${root}/lib]==])\nset(OPENFRUIT_PROXY_BINARY_ROOT [==[${root}/binary]==])\nset(OPENFRUIT_PROXY_OPTIONS_HEX \"${encoded}\")\n")
endfunction()
function(generate result)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=INCLUDE --unset=LIB --unset=LIBPATH
        "${CMAKE_COMMAND}" "-DOPENFRUIT_PROXY_INPUTS=${inputs}"
        "-DOPENFRUIT_PROXY_OUTPUT=${output}" -P "${module}"
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Identity generation failed: ${stderr}")
    endif()
    file(READ "${output}" contents)
    set(${result} "${contents}" PARENT_SCOPE)
endfunction()
write_inputs("compiler=original;flags=Release")
generate(baseline)
if(NOT baseline MATCHES "IDENTITY \"[0-9a-f]+\"")
    message(FATAL_ERROR "Complete owned inputs produced no component identity")
endif()
generate(warm)
if(NOT baseline STREQUAL warm)
    message(FATAL_ERROR "Unchanged inputs produced different identity")
endif()
file(APPEND "${root}/compiler.cpp" "// semantic implementation change\n")
generate(implementation)
if(baseline STREQUAL implementation)
    message(FATAL_ERROR "Implementation edit did not invalidate identity")
endif()
file(APPEND "${root}/shared.hpp" "// semantic shared interface change\n")
generate(header)
if(header STREQUAL implementation)
    message(FATAL_ERROR "Shared header edit did not invalidate identity")
endif()
file(APPEND "${root}/generator.cmake" "# generator change\n")
generate(generator)
if(generator STREQUAL header)
    message(FATAL_ERROR "Generator edit did not invalidate identity")
endif()
write_inputs("compiler=original;flags=Debug")
generate(options)
if(options STREQUAL generator)
    message(FATAL_ERROR "Compiler options did not invalidate identity")
endif()
file(APPEND "${root}/include/vector" "// standard library behavior change\n")
generate(standard_library)
if(options STREQUAL standard_library)
    message(FATAL_ERROR "Extensionless native standard library header did not invalidate identity")
endif()
file(APPEND "${root}/lib/owned.lib" "native import change\n")
generate(native_library)
if(standard_library STREQUAL native_library)
    message(FATAL_ERROR "Native import library did not invalidate identity")
endif()
file(APPEND "${root}/native-tool.exe" "tool implementation change\n")
generate(native_tool)
if(native_library STREQUAL native_tool)
    message(FATAL_ERROR "Native build tool binary did not invalidate identity")
endif()
file(APPEND "${root}/binary/generated-config.h" "// generated native ABI change\n")
generate(generated_header)
if(native_tool STREQUAL generated_header)
    message(FATAL_ERROR "Generated native header did not invalidate identity")
endif()
file(WRITE "${root}/binary/generated/compiler-proxy-identity/Release/identity.hpp" "// self output\n")
file(WRITE "${root}/binary/Testing/owned-fixture.hpp" "// independent fixture\n")
generate(excluded)
if(NOT generated_header STREQUAL excluded)
    message(FATAL_ERROR "Identity's own header or test fixture introduced a fingerprint feedback loop")
endif()
write_inputs("compiler=original;flags=Debug" ";${root}/missing-generated-input.hpp")
generate(missing)
if(NOT missing MATCHES "IDENTITY \"\"")
    message(FATAL_ERROR "Missing input falsely advertised a complete identity")
endif()
message(STATUS "Automatic compiler input identity positive/negative controls passed")
