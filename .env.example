# Copia questo file come .env. Non commettere mai .env.
#
# Metodo consigliato: cookie Netscape esportati in un file locale. Il percorso
# puo essere assoluto o relativo alla root di OPENFRUIT.
APPLE_COOKIE_JAR=.secrets/apple-developer-cookies.txt

# In alternativa, inserisci il valore completo dell'header Cookie su una riga.
# APPLE_DEVELOPER_COOKIE=myacinfo=...; dqsid=...

# Un FASTLANE_SESSION multilinea puo essere salvato come Base64. Il supporto e
# riservato al futuro login integrato; non inserire la password Apple ID qui.
# FASTLANE_SESSION_BASE64=

# Versione Xcode/SDK predefinita, sovrascrivibile dalla riga di comando.
OPENFRUIT_XCODE_VERSION=26.5
OPENFRUIT_XCODE_ARCHITECTURE=apple-silicon
