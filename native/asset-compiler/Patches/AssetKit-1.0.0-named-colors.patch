@@ -0,0 +1,26 @@
+import Foundation
+
+/// Preserves a PDF-backed imageset as a CoreUI vector rendition. Xcode uses
+/// the same DWAR/LZFSE envelope and vector key category as preserved SVG.
+enum PDFSource {
+    static func renditions(
+        bytes: Data,
+        assetName: String,
+        idiom: Idiom,
+        appearance: Appearance?,
+        filename: String
+    ) -> [Rendition] {
+        [Rendition(
+            name: assetName,
+            idiom: idiom,
+            scale: .x1,
+            appearance: appearance,
+            gamut: nil,
+            body: .preservedSource(PreservedSourceBody(
+                format: .pdf,
+                sourceData: bytes,
+                renditionName: filename
+            ))
+        )]
+    }
+}
